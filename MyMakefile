TOP != pwd
CC = cc
YACC = ${TOP}/cc/yacc/yacc

all: make sys cc

clean: make/clean sys/clean cc/clean
	rm -f *.core

distclean: clean
	rm -f mk

.c:
	${CC} -o $@ $< ${CFLAGS} ${CPPFLAGS}

.c.o:
	${CC} -c -o $@ $< ${CFLAGS} ${CPPFLAGS}

.export CC
.export TOP
.export YACC
.include make
.include cc
.include sys
