CFLAGS = -g -O0 -ansi -Wno-deprecated-non-prototype -Wno-comment -DFLEXNAMES -DBSD2_86 -Di286=1 -Dunix
OBJ = cpp.o cpy.o

all: cpp

clean:
	rm -f cpp y.tab.c *.o *.core

test: cpp
	./cpp -P < cpp.c | grep -v '^$$'

cpp: ${OBJ}
	${CC} -o $@ ${OBJ} ${CFLAGS}

cpp.o: cpp.c
	${CC} -c -o $@ cpp.c ${CFLAGS}

cpy.o: cpy.y yylex.c ../yacc/yacc
	${YACC} cpy.y
	${CC} -c -o $@ y.tab.c ${CFLAGS}
	rm -f y.tab.c
