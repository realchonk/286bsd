PWD != pwd
PREFIX ?= /usr

CFLAGS += -Wno-return-type -Wno-implicit-function-declaration -Wno-comment
CPPFLAGS = -DWORD32 -DPARSER=\"${PREFIX}/lib/yaccpar\"

all: yacc

install: yacc
	mkdir -p ${DESTDIR}${PREFIX}/bin ${DESTDIR}${PREFIX}/lib
	cp -f yacc ${DESTDIR}${PREFIX}/bin/
	cp -f yaccpar ${DESTDIR}${PREFIX}/lib/

yacc: y1.c y2.c y3.c y4.c
	${CC} -o $@ $* ${CFLAGS} ${CPPFLAGS}

clean:
	rm -f yacc *.o *.core y.tab.c calc.c

calc.c: yacc calc.y
	./yacc calc.y
	mv y.tab.c calc.c

run: calc
	./calc
