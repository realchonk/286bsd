TOP != pwd
CC ?= cc
YACC ?= ${TOP}/tools/bin/yacc

all: make sys cc

clean: make/clean sys/clean cc/clean
	rm -f *.core

distclean: clean
	rm -rf tools

todo:
	@find . -name 'TODO*' | while read -r file; do	\
		echo "=== $$file";			\
		cat "$$file";				\
		printf '\n\n';				\
	done | less

.c:
	${CC} -o $@ $< ${CFLAGS} ${CPPFLAGS}

.c.o:
	${CC} -c -o $@ $< ${CFLAGS} ${CPPFLAGS}

.export CC
.export TOP
.export YACC
.include make
.include cc
.include sys
