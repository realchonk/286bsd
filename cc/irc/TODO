- constructing fat pointers
  let $0: word = 24;
  let $1: word = 0;
  let $2: !byte = $0:$1;
- fat pointer manipulation
  let $0: !word = 0;
  let $1: word = fatoff $0;
  let $2: word = fatseg $0;
- pointer-integer casts
  let $0: word = 0;
  let $1: *word = cast $0;
  let $2: word = cast $1;
- type inference
  let $0: word = 0;
  let $1: word = 2;
  let $2 = add $0, $1;
