.include make
.include cc
.include sys

TOP != pwd

## Path to the C Compiler
CC ?= cc

## Path to Yacc
YACC ?= $./tools/bin/yacc

## Default C Compiler Flags
CFLAGS ?= -O2
CFLAGS += -ansi -Wall -Wno-deprecated-non-prototype -Wno-implicit-int

## Build everything
all: ${.SUBDIRS}

# See bug #1 in make/TODO.md
CLEAN = ${.SUBDIRS:=/clean}

## Clean everything
clean: ${CLEAN}
	rm -f *.core

## Clean even more things
distclean: clean
	rm -rf tools

## Get a list of all things to be done
todo:
	@find . -name 'TODO*' | while read -r file; do	\
		echo "=== $$file";			\
		cat "$$file";				\
		printf '\n\n';				\
	done | less

.c:
	${CC} -o $@ $< ${CFLAGS} ${CPPFLAGS}

.c.o:
	${CC} -c -o $@ $< ${CFLAGS} ${CPPFLAGS}

.template prog
## Installation prefix for ${NAME}
PREFIX ?= /usr

.if !"${NOMAN}"
## Installation prefix for ${NAME}'s manual
MANPREFIX ?= ${PREFIX}/man/man${MANSECTION}
MANSECTION ?= 1
.endif

## Installation prefix for ${NAME}'s binary
BINPREFIX ?= ${PREFIX}/bin

.DEFAULT: all

.if !target(all)
## Build ${NAME}
all: ${NAME}
.endif

.if !target(run)
## Run ${NAME}
run: ${NAME}
	./${NAME}
.endif

.if !target(clean)
## Clean build artifacts for ${NAME}
clean:
	rm -f ${NAME} *.core *.o
.endif

.if !target(install)
## Install ${NAME} into ${DESTDIR}${PREFIX}
install: install-bin install-man

## Install ${NAME}'s binary into ${DESTDIR}${BINPREFIX}
install-bin: ${NAME}
	mkdir -p ${DESTDIR}${BINPREFIX}/
	cp -f ${NAME} ${DESTDIR}${BINPREFIX}/

.if "${NOMAN}"
install-man:

.else
## Install ${NAME}'s manual into ${DESTDIR}${MANPREFIX}
install-man: ${NAME}.${MANSECTION}
	mkdir -p ${DESTDIR}${MANPREFIX}
	cp -f ${NAME}.${MANSECTION} ${DESTDIR}${MANPREFIX}/
.endif
.endif
.endt

.export CC
.export TOP
.export YACC
.export CFLAGS
