#!/bin/sh -e

[ -z "${CC}" ] && CC=cc
CFLAGS='-ansi -O0 -g -w'

mkdir -p tools/bin

${CC} -o 'tools/bin/mk' 'make/mk.c' 'make/compats.c' ${CFLAGS} -DHAVE_CONFIG_H

./tools/bin/mk clean
./tools/bin/mk CC="${CC}" PREFIX="${PWD}/tools" cc/yacc/install
./tools/bin/mk clean

ln -sf yacc tools/bin/xyacc

echo 'Please run:'
echo '$ . ./.env'
